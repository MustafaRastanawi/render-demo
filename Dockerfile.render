FROM php:7.4-apache

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    git \
    npm \
    unzip \
    libzip-dev \
    default-mysql-client \
    mariadb-server \
    mariadb-client \
    && docker-php-ext-install mysqli pdo pdo_mysql zip \
    && a2enmod rewrite \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

COPY . /var/www/html

RUN npm install -g bower

RUN if [ -f /var/www/html/contestInterface/bower.json ]; then \
      cd /var/www/html/contestInterface && bower install --allow-root; \
    fi && \
    if [ -f /var/www/html/teacherInterface/bower.json ]; then \
      cd /var/www/html/teacherInterface && bower install --allow-root; \
    fi

RUN mkdir -p /var/www/html/logs \
    /var/www/html/contestInterface/contests \
    /var/run/mysqld \
    /var/lib/mysql \
    && chown -R www-data:www-data /var/www/html/logs /var/www/html/contestInterface/contests \
    && chown -R mysql:mysql /var/run/mysqld /var/lib/mysql

RUN echo "display_errors = Off" > /usr/local/etc/php/conf.d/local-dev.ini \
    && echo "log_errors = On" >> /usr/local/etc/php/conf.d/local-dev.ini \
    && echo "error_reporting = E_ALL & ~E_DEPRECATED & ~E_NOTICE & ~E_WARNING" >> /usr/local/etc/php/conf.d/local-dev.ini

COPY render/start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 10000

CMD ["/start.sh"]
